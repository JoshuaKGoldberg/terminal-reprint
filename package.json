{
	"name": "terminal-reprint",
	"version": "0.1.0",
	"description": "Efficiently (re)-prints text into your terminal. 🖨",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/terminal-reprint.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg ✨",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"main": "lib/index.js",
	"files": [
		"LICENSE.md",
		"README.md",
		"lib/",
		"package.json"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"cli-cursor": "^5.0.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "9.39.5",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/eslint-plugin-markdown": "2.0.2",
		"@types/node": "24.13.6",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.9.0",
		"cspell": "10.3.3",
		"eslint": "9.39.5",
		"eslint-plugin-jsdoc": "64.5.4",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-package-json": "0.42.0",
		"eslint-plugin-perfectionist": "5.12.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "1.19.1",
		"husky": "9.1.7",
		"knip": "5.88.1",
		"lint-staged": "17.5.1",
		"markdownlint": "0.41.1",
		"markdownlint-cli": "0.49.1",
		"prettier": "3.9.8",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "2.5.15",
		"prettier-plugin-sh": "0.19.0",
		"release-it": "19.2.4",
		"sentences-per-line": "0.3.0",
		"tsdown": "0.12.7",
		"typescript": "5.9.3",
		"typescript-eslint": "8.35.0",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
